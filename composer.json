{
  "name": "viswoole/viswoole",
  "description": "viswoole是一个基于swoole扩展的高性能开发框架。",
  "keywords": [
    "framework",
    "viswoole"
  ],
  "homepage": "https://viswoole.com",
  "minimum-stability": "stable",
  "prefer-stable": true,
  "type": "project",
  "license": "MIT",
  "authors": [
    {
      "name": "zhuchonglin",
      "email": "8210856@qq.com"
    }
  ],
  "require": {
    "php": ">=8.3",
    "ext-swoole": ">=5.1",
    "ext-sockets": "*",
    "viswoole/framework": "^1.1.0"
  },
  "require-dev": {
    "swoole/ide-helper": ">=5.1"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "php viswoole vendor:publish",
      "php viswoole service:discover",
      "php viswoole command:discover"
    ]
  }
}
